# copy to .env and fill in — never commit .env

# --- Django ---
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# --- Database: leave POSTGRES_DB blank to use local SQLite ---
# Supabase -> Connect -> Transaction pooler (shared, aws-0-...pooler.supabase.com)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=6543

# --- File uploads: leave SUPABASE_S3_BUCKET blank to save to media/ locally ---
# Supabase -> Storage -> S3
SUPABASE_S3_BUCKET=
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
